{
  "name": "@agentic-kb/react",
  "version": "0.1.0",
  "description": "Production-ready embeddable React Chatbot and JavaScript Widget for Agentic KnowledgeBase SDK",
  "type": "module",
  "main": "./dist/agentic-kb.umd.cjs",
  "module": "./dist/agentic-kb.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/agentic-kb.js",
      "require": "./dist/agentic-kb.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./widget": "./dist/agentic-kb-widget.iife.js",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:widget": "vite build --config vite.config.widget.ts",
    "build": "npm run build:types && npm run build:lib && npm run build:widget",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.1.2",
    "lucide-react": "^0.378.0",
    "marked": "^12.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
